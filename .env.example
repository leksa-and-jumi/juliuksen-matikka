# Copy to .env.local and fill in. Never commit .env.local!
# Kopioi tiedostoon .env.local ja täytä. Älä koskaan commitoi .env.localia!

# Convex dashboard → dev deployment → Settings → Deploy keys → "Generate development deploy key"
CONVEX_DEPLOY_KEY_DEV=dev:TAYTA_TAHAN
# Convex dashboard → production deployment → Settings → Deploy keys → "Generate production deploy key"
CONVEX_DEPLOY_KEY_PROD=prod:TAYTA_TAHAN

# Dev deployment URL (dashboard → dev → Settings → URL & Deploy Key), e.g. https://happy-otter-123.convex.cloud
# Leave empty to run without Convex: progress is then saved only in this browser.
VITE_CONVEX_URL=
